<% layout("/layouts/headerFooter.ejs") %>

<div class="page">
    <div class="container py-5">
        <h1 class="text-center mb-5">Contact Us</h1>
        
        <div class="row justify-content-center">
            <div class="col-md-8">
                <% if (success && success.length > 0) { %>
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <%= success %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>
                
                <% if (error && error.length > 0) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <%= error %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow-lg">
                    <div class="card-body p-5">
                        <div class="row mb-5">
                            <div class="col-md-4 text-center mb-4 mb-md-0">
                                <div class="contact-card">
                                    <i class="bi bi-envelope contact-icon mb-3"></i>
                                    <h5>Email</h5>
                                    <p>contact@example.com</p>
                                </div>
                            </div>
                            <div class="col-md-4 text-center mb-4 mb-md-0">
                                <div class="contact-card">
                                    <i class="bi bi-telephone contact-icon mb-3"></i>
                                    <h5>Phone</h5>
                                    <p>53271117</p>
                                </div>
                            </div>
                            <div class="col-md-4 text-center">
                                <div class="contact-card">
                                    <i class="bi bi-geo-alt contact-icon mb-3"></i>
                                    <h5>Address</h5>
                                    <p>11 4a St - Deira<br>Dubai - UAE</p>
                                </div>
                            </div>
                        </div>

                        <form class="contact-form" action="/contact" method="POST">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="name" class="form-label">Name</label>
                                    <input type="text" class="form-control" id="name" name="name" required>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="email" class="form-label">Email</label>
                                    <input type="email" class="form-control" id="email" name="email" required>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label for="service" class="form-label">Service Type</label>
                                <select class="form-control" id="service" name="service" required>
                                    <option value="" disabled selected>Select a service...</option>
                                    <option value="Door">Door Maintenance & Installation</option>
                                    <option value="Shifting">Shifting Services</option>
                                    <option value="Indoor">Indoor Services (AC & General)</option>
                                    <option value="Kitchen">Kitchen Renovation & Maintenance</option>
                                    <option value="Outdoor">Outdoor Maintenance</option>
                                    <option value="Paint">Painting Services</option>
                                    <option value="Tiles">Tile Work & Installation</option>
                                    <option value="Gypsum">Gypsum Work & Installation</option>
                                    <option value="Other">Other Services</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="location" class="form-label">Location of Work</label>
                                <input 
                                    type="text" 
                                    class="form-control" 
                                    id="location" 
                                    name="location" 
                                    placeholder="UAE" 
                                    value="UAE"
                                    required
                                >
                            </div>
                            <div class="mb-3">
                                <label for="message" class="form-label">Message</label>
                                <textarea class="form-control" id="message" name="message" rows="5" required></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary">Send Message</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Bootstrap JS for alert dismissal -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>