<% layout("/layouts/headerFooter.ejs") %>

<div class="page">
    <div class="container py-5">

        <h1 class="text-center mb-5">Contact Us</h1>
         <!-- Flash Messages -->
           
         <div class="row justify-content-center">
            <div class="col-md-8">
            <% if (success && success.length > 0) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <%= success %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>
            
            <% if (error && error.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <%= error %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>
        </div>
        </div>


       
    
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow-lg">
                    <div class="card-body p-5">
                        <div class="row mb-5">
                            <div class="col-md-4 text-center mb-4 mb-md-0">
                                <div class="contact-card">
                                    <i class="bi bi-envelope contact-icon mb-3"></i>
                                    <h5>Email</h5>
                                    <p>aljamiyadubai@gmail.com</p>
                                </div>
                            </div>
                            <div class="col-md-4 text-center mb-4 mb-md-0">
                                <div class="contact-card">
                                    <i class="bi bi-telephone contact-icon mb-3"></i>
                                    <h5>Phone</h5>
                                    <p>+97153271117</p>
                                </div>
                            </div>
                            <div class="col-md-4 text-center">
                                <div class="contact-card">
                                    <i class="bi bi-geo-alt contact-icon mb-3"></i>
                                    <h5>Address</h5>
                                    <p>11 4a St - Deira<br>Dubai - UAE</p>
                                </div>
                            </div>
                        </div>

                        <form class="contact-form needs-validation" action="/contact" method="POST" novalidate>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="name" class="form-label">Name</label>
                                    <input 
                                        type="text" 
                                        class="form-control" 
                                        id="name" 
                                        name="name" 
                                        required
                                        minlength="2"
                                    >
                                    <div class="valid-feedback">
                                        Looks good!
                                    </div>
                                    <div class="invalid-feedback">
                                        Please enter your name (minimum 2 characters).
                                    </div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="email" class="form-label">Email</label>
                                    <input 
                                        type="email" 
                                        class="form-control" 
                                        id="email" 
                                        name="email" 
                                        required
                                    >
                                    <div class="valid-feedback">
                                        Looks good!
                                    </div>
                                    <div class="invalid-feedback">
                                        Please enter a valid email address.
                                    </div>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label for="service" class="form-label">Service Type</label>
                                <select class="form-select" id="service" name="service" required>
                                    <option value="" disabled selected>Select a service...</option>
                                    <option value="Door">Door Maintenance & Installation</option>
                                    <option value="Shifting">Shifting Services</option>
                                    <option value="Indoor">Indoor Services (AC & General)</option>
                                    <option value="Kitchen">Kitchen Renovation & Maintenance</option>
                                    <option value="Outdoor">Outdoor Maintenance</option>
                                    <option value="Paint">Painting Services</option>
                                    <option value="Tiles">Tile Work & Installation</option>
                                    <option value="Gypsum">Gypsum Work & Installation</option>
                                    <option value="Other">Other Services</option>
                                </select>
                                <div class="valid-feedback">
                                    Looks good!
                                </div>
                                <div class="invalid-feedback">
                                    Please select a service type.
                                </div>
                            </div>
                            <div class="mb-3">
                                <label for="location" class="form-label">Location of Work</label>
                                <input 
                                    type="text" 
                                    class="form-control" 
                                    id="location" 
                                    name="location" 
                                    placeholder="UAE" 
                                    value="UAE"
                                    required
                                    minlength="2"
                                >
                                <div class="valid-feedback">
                                    Looks good!
                                </div>
                                <div class="invalid-feedback">
                                    Please enter a valid location (minimum 2 characters).
                                </div>
                            </div>
                            <div class="mb-3">
                                <label for="message" class="form-label">Message</label>
                                <textarea 
                                    class="form-control" 
                                    id="message" 
                                    name="message" 
                                    rows="5" 
                                    required
                                    minlength="10"
                                ></textarea>
                                <div class="valid-feedback">
                                    Looks good!
                                </div>
                                <div class="invalid-feedback">
                                    Please enter your message (minimum 10 characters).
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary">Send Message</button>
                        </form>

                       
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Bootstrap JS for form validation -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<!-- Add custom styles for form validation -->
<style>
    .form-control:valid,
    .form-select:valid {
        border-color: #198754;
        padding-right: calc(1.5em + 0.75rem);
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 8 8'%3e%3cpath fill='%23198754' d='M2.3 6.73L.6 4.53c-.4-1.04.46-1.4 1.1-.8l1.1 1.4 3.4-3.8c.6-.63 1.6-.27 1.2.7l-4 4.6c-.43.5-.8.4-1.1.1z'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right calc(0.375em + 0.1875rem) center;
        background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
    }

    .form-control:invalid,
    .form-select:invalid {
        border-color: #dc3545;
        padding-right: calc(1.5em + 0.75rem);
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23dc3545'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath stroke-linejoin='round' d='M5.8 3.6h.4L6 6.5z'/%3e%3ccircle cx='6' cy='8.2' r='.6' fill='%23dc3545' stroke='none'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right calc(0.375em + 0.1875rem) center;
        background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
    }

    .was-validated .form-control:valid:focus,
    .was-validated .form-select:valid:focus {
        border-color: #198754;
        box-shadow: 0 0 0 0.25rem rgba(25, 135, 84, 0.25);
    }

    .was-validated .form-control:invalid:focus,
    .was-validated .form-select:invalid:focus {
        border-color: #dc3545;
        box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.25);
    }

    .valid-feedback,
    .invalid-feedback {
        display: none;
        margin-top: 0.25rem;
        font-size: 0.875em;
    }

    .was-validated .valid-feedback {
        display: block;
        color: #198754;
    }

    .was-validated .invalid-feedback {
        display: block;
        color: #dc3545;
    }

    textarea.form-control {
        padding-right: calc(1.5em + 0.75rem);
        background-position: top calc(0.375em + 0.1875rem) right calc(0.375em + 0.1875rem);
    }
</style>